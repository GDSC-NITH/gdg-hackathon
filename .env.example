# Env vars for api/chat.js (the Labyrinth chat backend — a Vercel serverless
# function). Copy this to .env and fill in your own values for local testing
# with `vercel dev`, and set the same ones in Vercel's Project Settings ->
# Environment Variables for the deployed site.

# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Tried in order after GROQ_API_KEY if it's rate-limited, invalid,
# or unauthorized (not for a plain bad request or a retired model id).
GROQ_API_KEY_BACKUP_1=
GROQ_API_KEY_BACKUP_2=

# Optional. Any current production Groq model id; see https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Per-IP request limit, to stop one visitor spamming/draining quota.
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=600000

# Optional. Two off-topic replies in a row from the same IP locks it out of
# further replies for this long (see api/knowledge.js's OFFTOPIC: convention).
OFFTOPIC_STRIKE_LIMIT=2
OFFTOPIC_LOCKOUT_MS=900000
